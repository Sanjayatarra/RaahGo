# ==============================================================================
# RaahGo Backend Environment Configuration Example
# Copy this file to .env on your server and update the values.
# NEVER commit the actual .env file with real secrets to GitHub!
# ==============================================================================

# Django Core
SECRET_KEY=your-strong-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,127.0.0.1,localhost

# Email SMTP configuration for sending OTP & notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

# IMAP Server Configuration (if applicable)
config_type=imap
server_type=imap
host=imap.gmail.com
port=993
email=your-email@example.com
password=your-app-password
security=ssl

# JWT Token Lifetime Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# Location & Services
LOCATION_SUGGESTION_RADIUS_KM=50
MEDIA_URL=/media/

# Redis & Channels Configuration (WebSocket live tracking)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CHANNEL_URL=redis://127.0.0.1:6379/1

# Live Location Tracking Settings
LOCATION_CACHE_TTL=30
STALE_DRIVER_THRESHOLD_SECONDS=60
DEFAULT_SEARCH_RADIUS_KM=5
MAX_SEARCH_RADIUS_KM=15
GPS_RATE_LIMIT_PER_SEC=2

# Ride Matching, Driver Heartbeat & Presence Settings
DRIVER_HEARTBEAT_INTERVAL_SECONDS=10
DRIVER_HEARTBEAT_TIMEOUT_SECONDS=45
DRIVER_PRESENCE_TTL_SECONDS=60

MATCHING_INITIAL_RADIUS_KM=3
MATCHING_MAX_RADIUS_KM=10
MATCHING_OFFER_WINDOW_SECONDS=30
MATCHING_OVERALL_DEADLINE_SECONDS=180
MATCHING_CONCURRENT_OFFERS=3

# Firebase Cloud Messaging (FCM)
FIREBASE_CREDENTIALS_PATH=
